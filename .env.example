# Copy to .env and fill in real values. .env itself must never be committed.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# sqlite (default, offline) vs postgres (live, needs DATABASE_URL + psycopg):
# RESALE_LISTING_AI_DB_MODE=postgres

# local (default, offline in-memory) vs sqs (real SQS or LocalStack via
# AWS_ENDPOINT_URL, needs boto3):
# RESALE_LISTING_AI_QUEUE_MODE=sqs
# AWS_ENDPOINT_URL=http://localhost:4566   # LocalStack (docker-compose up -d); omit for real AWS
# AWS_REGION=ca-central-1

# Intake API (resale_listing_ai/api.py) — comma-separated keys; every /v1/* request must
# send one via the X-API-Key header, or it gets a 401:
# RESALE_LISTING_AI_API_KEYS=changeme-issue-one-per-consumer

# RESALE_LISTING_AI_COOKIE_SECURE=0   # only for local HTTP dev — auth cookies default to Secure (HTTPS-only)

# image_process's originals/scrubbed/finished uploads auto-fall-back to local
# disk when S3 isn't reachable (no AWS creds, unreachable bucket, etc.) --
# no env var needed to opt in. Override the local write directory (default
# out/images) if needed. NOTE: this is read at import time, before .env is
# loaded, so it must be a real exported environment variable (shell,
# systemd unit, container env, etc. -- e.g. `export RESALE_LISTING_AI_LOCAL_IMAGE_DIR=...`
# before the process starts), not just a line in .env:
# RESALE_LISTING_AI_LOCAL_IMAGE_DIR=out/images

# ---- provider API keys (only needed for real, non-stub adapter calls) ----
# Default provider for every seam is OpenAI, so this covers vision, web search,
# image classification and copy on its own:
# OPENAI_API_KEY=sk-...
# Alternative web-search-with-citations provider (RESALE_LISTING_AI_WEB_SEARCH_PROVIDER=perplexity_sonar):
# PERPLEXITY_API_KEY=pplx-...
# Gemini — vision / classify / copy / google-search grounding (resale_listing_ai/providers/gemini.py):
# GEMINI_API_KEY=...
# OpenRouter — same four seams, routed to many vendors (resale_listing_ai/providers/openrouter.py):
# OPENROUTER_API_KEY=sk-or-...
# Bedrock — vision / classify (Claude via Converse) / image_process (Nova Canvas)
# (resale_listing_ai/providers/bedrock.py). AWS_BEARER_TOKEN_BEDROCK is the account's
# Bedrock API key (bearer token); if unset, falls back to standard
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY credentials or an IAM role instead:
# AWS_BEARER_TOKEN_BEDROCK=...
# RESALE_LISTING_AI_BEDROCK_REGION=us-east-1
# Claude 4.x on Bedrock needs a REGION-PREFIXED cross-region inference profile
# id, not the bare model id (the bare id fails with "Invocation of model ID ...
# with on-demand throughput isn't supported"). The prefix must track
# RESALE_LISTING_AI_BEDROCK_REGION: us.* for us-*, eu.* for eu-*, apac.* for ap-*
# (global.* for the global profile). Default: us.anthropic.claude-haiku-4-5-20251001-v1:0
# RESALE_LISTING_AI_BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Nova Canvas image model + its read timeout (>=300s recommended by AWS):
# RESALE_LISTING_AI_BEDROCK_IMAGE_MODEL=amazon.nova-canvas-v1:0
# RESALE_LISTING_AI_BEDROCK_IMAGE_READ_TIMEOUT=300
# Model id for OpenRouter. NO DEFAULT — OpenRouter's catalog changes over time, so this
# must be set explicitly or the provider raises rather than calling with model=None.
# Use any model id from your OpenRouter dashboard:
# RESALE_LISTING_AI_OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Background removal + masked inpaint in image_process (not needed by run_live_demo.py,
# which stops before the image stage):
# PHOTOROOM_API_KEY=...
# CLIPDROP_API_KEY=...
# JSON-repair LLM fallback when json_repair_provider=claude (config/provider_stack.json):
# ANTHROPIC_API_KEY=sk-ant-...

# ---- provider selection (defaults live in config/provider_stack.json; all OpenAI) ----
# vision_identify AND image_process's classify step — openai (default) | gemini | openrouter | bedrock:
# RESALE_LISTING_AI_VISION_PROVIDER=gemini
# generate_copy — openai (default) | gemini | openrouter:
# RESALE_LISTING_AI_COPY_PROVIDER=gemini
# image_match / retail_price / resale_price share one provider —
# openai_web_search (default) | perplexity_sonar | gemini_search | openrouter_online:
# RESALE_LISTING_AI_WEB_SEARCH_PROVIDER=gemini_search
# image_process's background-removal/inpaint step — photoroom_clipdrop (default) | gemini | bedrock:
# RESALE_LISTING_AI_IMAGE_PROCESS_PROVIDER=gemini
# RESALE_LISTING_AI_IMAGE_PROCESS_PROVIDER=bedrock

# Force every adapter (including the real ones) back to the offline stub path:
# RESALE_LISTING_AI_STUBS=1

# ---- bootstrap admin ----
# There is no self-service admin signup (register always creates a 'submitter').
# When the app container starts with RESALE_LISTING_AI_BOOTSTRAP_ADMIN=1 (set on the `app`
# service in docker-compose.yml) it ensures this admin exists: creates it with the
# password below, or promotes an existing user of that email to admin (an existing
# password is never changed). You can also run it by hand, any time:
#   docker compose exec app python -m resale_listing_ai.admin create-admin you@example.com
# RESALE_LISTING_AI_ADMIN_EMAIL=admin@example.com
# RESALE_LISTING_AI_ADMIN_PASSWORD=change-me-to-a-strong-password
